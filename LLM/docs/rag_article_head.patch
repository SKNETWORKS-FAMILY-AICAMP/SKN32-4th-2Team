+# [로컬 테스트 전용 수정 — LLM 파트]
+# 임베딩·리랭커를 GPU 로 올린다. 원본은 임베딩이 "cpu" 로 고정돼 있었고
+# 리랭커는 지정이 없었다.
+#
+# 환경변수로 끌 수 있게 둔 이유: GPU 가 없는 팀원 PC 에서도 그대로 돌아가야 한다.
+#   RAG_DEVICE=cpu   → 강제로 CPU
+#   RAG_DEVICE=cuda  → 강제로 GPU (없으면 에러가 나서 바로 알 수 있다)
+#   미지정           → 있으면 GPU, 없으면 CPU
+def _device() -> str:
+    forced = os.getenv("RAG_DEVICE", "").strip().lower()
+    if forced:
+        return forced
+    try:
+        import torch
+
+        return "cuda" if torch.cuda.is_available() else "cpu"
+    except ImportError:
+        return "cpu"
+
