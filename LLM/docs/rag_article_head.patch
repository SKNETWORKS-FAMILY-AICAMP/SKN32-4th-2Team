+# [로컬 테스트 전용 수정 — LLM 파트] 청크에 조문 머리를 붙인다.
+#
+# 문제: 청킹이 길이(400자) 단위라 조문 중간에서 끊긴다. 그러면 두 번째 이후
+# 청크는 몇 조인지 알 수 없다.
+#
+#   법제처 14 국가법령정보센터 근로기준법 1. 8시간 이내의 휴일근로: 통상임금의
+#   100분의 50 2. 8시간을 초과한 휴일근로: 통상임금의 100분의 100 ③ 사용자는...
+#
+# 이게 LLM 답변 품질에 두 가지로 영향을 준다.
+#   1) 조문 인용이 틀린다 — 컨텍스트에 조 번호가 없으니 모델이 기억으로 붙인다
+#      (휴일근로 수당은 제56조인데 제55조·제57조를 댔다)
+#   2) 내용이 잘려 근거가 사라진다 — "유급휴가 15일" 은 제60조 ① 에 있는데
+#      청크가 그 뒤부터 시작해 "15일" 이 컨텍스트에 아예 없다
+#
+# 해결: 페이지 전체를 훑어 각 청크가 어느 조문에 속하는지 찾고, 조문 머리가
+# 청크 안에 안 보이면 앞에 붙여 준다. 조문 머리를 이미 갖고 있으면 그대로 둔다.
+_ARTICLE_HEAD = re.compile(r"제\s?\d+조(?:의\s?\d+)?\s*\([^)]{1,40}\)")
+
+
+def _article_heads(text: str) -> List[tuple]:
+    """본문에서 (위치, 조문 머리) 목록을 뽑는다."""
+    return [(m.start(), re.sub(r"\s+", " ", m.group(0)).strip()) for m in _ARTICLE_HEAD.finditer(text)]
+
+
+def _head_for(offset: int, heads: List[tuple]) -> Optional[str]:
+    """이 위치보다 앞에 있는 가장 가까운 조문 머리."""
+    found = None
+    for pos, head in heads:
+        if pos <= offset:
+            found = head
+        else:
+            break
+    return found
+
+
