# 공개 모델이므로 HF_TOKEN은 필수가 아닙니다. 사용할 경우 Read 권한만 권장합니다.
HF_TOKEN=
HF_HOME=/workspace/.cache/huggingface
TORCH_HOME=/workspace/.cache/torch
MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
# 2026-08-03 기준 Hugging Face 모델 저장소 commit. 재현성을 위해 main 대신 고정합니다.
MODEL_REVISION=a09a35458c702b33eeacc393d103063234e8bc28

ADAPTER_DIR=outputs/qwen2.5-7b-hr-korean-lora
TRAIN_FILE=data/train.jsonl
VALID_FILE=data/valid.jsonl
HOLDOUT_FILE=data/holdout.jsonl

SEED=42
MAX_LENGTH=2048
MAX_NEW_TOKENS=500
TRAIN_BATCH_SIZE=1
EVAL_BATCH_SIZE=1
GRADIENT_ACCUMULATION_STEPS=8
NUM_TRAIN_EPOCHS=3
LEARNING_RATE=0.0001
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05

MIN_TRAIN_SAMPLES=80
MIN_VALID_SAMPLES=20
LATENCY_GATE_MS=5000
EVAL_REPEATS=3
