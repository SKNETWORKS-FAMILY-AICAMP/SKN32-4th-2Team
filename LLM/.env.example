# 이 파일을 .env 로 복사한 뒤 실제 키를 채워 넣으세요.
#   cp .env.example .env
# .env 는 .gitignore 에 있으므로 절대 커밋되지 않습니다.

# ---------------------------------------------------------
# 서비스
# ---------------------------------------------------------
LLM_SERVICE_PORT=8002

# live = 실제 LLM API 호출 / mock = 고정 응답
# API 키가 아직 없어도 팀원이 화면을 붙여볼 수 있게 하는 스위치입니다.
# 공개 API 계약은 두 모드가 완전히 동일하므로 프론트 코드는 바꿀 필요가 없습니다.
LLM_MODE=live

# 기본 프로바이더 (openai | gemini)
# 요청 body 의 "provider" 로 매 호출마다 덮어쓸 수 있습니다.
DEFAULT_PROVIDER=openai

# 응답 생성 타임아웃(초). 초과 시 504 + 한국어 안내 메시지 반환.
# 스토리보드(13p) "5초 -> 일시적인 오류입니다" 요구사항 기준.
LLM_TIMEOUT_SEC=5.0

# 답변 길이 상한(토큰). 프롬프트로 "3~6문장"을 요구하지만 지시일 뿐이라
# 모델이 안 지킬 수 있다. 정상 답변은 중앙값 226자(≈200토큰)라 여유가 있다.
ANSWER_MAX_TOKENS=500

# 답변에 조문 번호를 인용할지. 최신 RAG의 조문 머리 고도화와 대상 인덱스 재적재,
# WEB → LLM → RAG E2E 검증이 완료된 현재 통합 구성에서는 true를 사용합니다.
ANSWER_CITE_ARTICLES=true

# ---------------------------------------------------------
# OpenAI
# ---------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------
# Gemini
# ---------------------------------------------------------
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.5-flash

# ---------------------------------------------------------
# 주제 분류 방법
# ---------------------------------------------------------
# llm   = 현행. 프로바이더에 enum 제약 호출을 한 번 더 보냄
# embed = 임베딩 유사도로 분류. API 호출 없음, 로컬 모델 필요
TOPIC_METHOD=llm
TOPIC_EMBED_MODEL=jhgan/ko-sroberta-multitask

# ---------------------------------------------------------
# RAG 서비스 (Member C 담당, port 8001)
# ---------------------------------------------------------
# live = 실제 호출 / mock = 고정 응답으로 개발
RAG_MODE=live
RAG_BASE_URL=http://127.0.0.1:8001
# CPU 리랭커 검색은 약 15~26초가 측정됐다. GPU 전환 전 개발·시연 환경에서는
# 여유를 두고 45초로 둔다. GPU 성능 측정 후 서비스 수준에 맞게 재조정한다.
RAG_TIMEOUT_SEC=45.0
RAG_TOP_K=5

# 관련도가 이 값 미만인 검색 결과는 버린다. 무관한 문서를 근거로 착각해
# 없는 수치를 지어내는 것을 막는다. 0 이면 기능 꺼짐.
RAG_MIN_SCORE=0.01

# ---------------------------------------------------------
# 계측 로그
# ---------------------------------------------------------
# 지연/토큰/모델명은 API 응답에 넣지 않고 이 파일에만 남깁니다.
# 성능 보고서(bench/report.py)가 이 파일을 읽어 집계합니다.
METRICS_PATH=logs/metrics.jsonl
METRICS_ENABLED=true
