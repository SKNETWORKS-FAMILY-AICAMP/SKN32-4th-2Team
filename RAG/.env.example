# Copy this file to .env and fill only local or deployment-specific values.
# Never commit the real .env file.

# API
RAG_API_HOST=0.0.0.0
RAG_API_PORT=8001
RAG_CORS_ORIGINS=http://127.0.0.1:8100,http://localhost:8100

# MySQL
RAG_DB_HOST=127.0.0.1
RAG_DB_PORT=3306
RAG_DB_USER=change-me
RAG_DB_PASSWORD=change-me
RAG_DB_NAME=rag_chatbot

# Retrieval runtime
# Leave RAG_DEVICE empty for automatic selection. Use cpu or cuda only for an explicit test.
# RAG_DEVICE=
# Set to 0 only when comparing the old chunking behavior. Reindex after changing it.
# RAG_ARTICLE_HEAD=1
# RAG_CHUNK_SIZE=400
# RAG_CHUNK_OVERLAP=80
# RAG_MIN_CHUNK_LENGTH=80
# RAG_EMBEDDING_MODEL=jhgan/ko-sroberta-multitask
# RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_SEARCH_TOP_K=5
RAG_SEARCH_INITIAL_CANDIDATES=20
