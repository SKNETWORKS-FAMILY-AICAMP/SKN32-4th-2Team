# Django가 사용하는 새 운영 DB입니다. RAG/.env의 RAG_DB_*도 같은 대상이어야 합니다.
DATABASE_URL=mysql+pymysql://change-user:change-pw@change-ip:change-port/rag_chatbot_v4?charset=utf8mb4
# 레거시 DB가 남아 있는 사람만 추가: 사용자·채팅 이관 전용 읽기 원본입니다.
# 레거시 DB가 없는 사람은 이 변수를 설정하지 않고 일반 초기화만 진행합니다.
# DATABASE_URL과 같은 host/port/schema를 가리키면 안 되며, SELECT 전용 계정을 사용하세요.
# chat_source의 과거 파일명·페이지 스냅샷만 이관하고 RAG document·PDF·vector_store는 이관하지 않습니다.
# 이 URL은 서버 런타임에는 사용하지 않습니다.
# 이관 완료 뒤에는 제거하거나 비워 두세요.
# LEGACY_DATABASE_URL=mysql+pymysql://legacy-readonly:change-pw@legacy-ip:3306/rag_chatbot?charset=utf8mb4
SESSION_SECRET_KEY=change-me-to-a-random-secret
CHAT_API_BASE_URL=http://localhost:8002
# RAG 최대 45초 + LLM 최대 15초 뒤에도 응답을 받을 수 있도록 여유를 둡니다.
CHAT_API_TIMEOUT_SECONDS=70
DOC_API_BASE_URL=http://localhost:8001
